{
  "compilerOptions": {
  "target": "ES2022",
  "module": "Node16",
  "moduleResolution": "Node16",
  "esModuleInterop": true,
  "experimentalDecorators": true,
  "emitDecoratorMetadata": true,
  "strict": true,
  "skipLibCheck": true,
  "rootDir": "./src",
  "outDir": "./dist",
  "typeRoots": [
  "./node_modules/@types"
  ]
  },
  "include": ["src/**/*"]
}
